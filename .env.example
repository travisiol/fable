# ── Solana
# mainnet-beta (default) | devnet — inlined in the browser bundle at build time
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Server RPC, keyed provider recommended (holder snapshots need getProgramAccounts). Default: public endpoint.
SOLANA_RPC_URL=
# The FABLE token mint. Empty = no balances read, no snapshots, no allocations from holdings. Never invent one.
NEXT_PUBLIC_FABLE_MINT=

# ── Persistence (Vercel)
# Postgres (Neon / Vercel Postgres). Empty = PGlite in ./data/pglite (ephemeral /tmp on Vercel).
DATABASE_URL=
# Vercel Blob for generated images and clips. Empty = ./data/media (ephemeral on Vercel).
BLOB_READ_WRITE_TOKEN=
# 32+ random characters (session cookie). Empty = generated once and kept in the database.
SESSION_SECRET=
# Public address of the site (token metadata URI, metadata base)
NEXT_PUBLIC_SITE_URL=

# ── AI providers (server-side only)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
# Talking clips (Google Veo through the Gemini API). OpenAI's Videos API (Sora 2) shut down on 2026-09-24.
GEMINI_API_KEY=
# FABLE_VIDEO_MODEL=veo-3.1-generate-preview

# ── Character coin launch (pump.fun) — off unless all of these are set
FABLE_LAUNCH_ENABLED=
# Fee-sharing recipients (must differ): 30 % holder pool, 40 % character budgets
FABLE_POOL_WALLET=
FABLE_BUDGET_WALLET=
# Set to 1 once a launch's 30/40/30 split has been verified on chain: the homepage then says "active"
FABLE_FEE_SHARING_VERIFIED=
# Optional: pays network fees for the permissionless sweep + distribute crank (holds no user funds)
OPERATOR_SECRET_KEY=

# ── Economics (defaults in src/config/fable.ts)
# FABLE_CREDIT_LAMPORTS=50000
# FABLE_MIN_AVERAGE_TOKENS=100000
# FABLE_MAX_CREDITS_PER_WALLET=300
# FABLE_WEEKLY_SHARE_BPS=5000
# FABLE_OPERATING_RESERVE_BPS=1500

# ── Operations
# Authorises /api/cron/daily and /api/jobs/tick (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Comma-separated owner wallets (record deposits, grant credits on /settings/config)
FABLE_ADMIN_WALLETS=
